{
  "name": "m01-web-exchange",
  "description": "Canonical logical timeline for tracing one web exchange across layers and devices.",
  "events": [
    {
      "step": 1,
      "actor": "application",
      "action": "resolve_name",
      "state": "hostname"
    },
    {
      "step": 2,
      "actor": "resolver",
      "action": "dns_query",
      "state": "UDP_or_TCP_transport"
    },
    {
      "step": 3,
      "actor": "host_kernel",
      "action": "route_lookup",
      "state": "destination_IP_and_route"
    },
    {
      "step": 4,
      "actor": "host_kernel",
      "action": "neighbor_resolution_if_needed",
      "state": "next_hop_link_address"
    },
    {
      "step": 5,
      "actor": "host",
      "action": "emit_frame",
      "state": "link_frame_contains_IP_packet"
    },
    {
      "step": 6,
      "actor": "router",
      "action": "forward_packet",
      "state": "new_link_frame_same_logical_IP_packet"
    },
    {
      "step": 7,
      "actor": "remote_host",
      "action": "deliver_transport_data",
      "state": "socket_receive_state"
    },
    {
      "step": 8,
      "actor": "remote_application",
      "action": "process_request",
      "state": "application_protocol"
    }
  ]
}
